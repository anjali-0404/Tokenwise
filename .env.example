# ─── Bifrost (OpenAI-compatible gateway) ───────────────────────────────────────
# Full URL including path; default shown below.
BIFROST_URL=http://localhost:8080/v1/chat/completions

# API key forwarded to Bifrost (may be any non-empty string if Bifrost handles auth)
BIFROST_API_KEY=bfst-A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2

# ─── Tavily web search ──────────────────────────────────────────────────────────
TAVILY_API_KEY=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

# ─── Models (use provider/model Bifrost naming) ─────────────────────────────────
# Small / fast model for simple tasks
MODEL_SMALL=openai/gpt-4o-mini

# Large / strong model for complex tasks
MODEL_LARGE=openai/gpt-4o

# Backup model when primary provider fails
MODEL_BACKUP=anthropic/claude-3-5-haiku-20241022

# Local Ollama model used for confidential repos
MODEL_LOCAL=ollama/qwen2.5-coder:3b

# ─── Remote Ollama (optional) ──────────────────────────────────────────────────
# Default is http://localhost:11434. For cloud deployments, set to your remote Ollama host or tunnel:
# OLLAMA_HOST=https://your-ollama-instance.com
# OLLAMA_API_KEY=your_key_if_secured

# ─── Pricing (USD per 1 k tokens, combined in+out estimate) ────────────────────
PRICE_SMALL=0.000200
PRICE_LARGE=0.010000
PRICE_BACKUP=0.003000
PRICE_LOCAL=0.000000

# ─── Sandbox ───────────────────────────────────────────────────────────────────
# Absolute path where the agent is allowed to read/write files and run shells.
# Never set this to a system directory.
WORKSPACE_DIR=/tmp/tokenwise-workspace

# ─── Budget persistence ─────────────────────────────────────────────────────────
# Path to the SQLite database file (or JSON file when sqlite3 is unavailable).
BUDGET_DB_PATH=./data/budget.json

# ─── Misc ───────────────────────────────────────────────────────────────────────
# Set to 1 to run fully offline (no Bifrost, no Tavily; canned responses)
MOCK=0

# Max concurrent tool-call iterations per request
MAX_STEPS=8

# Default per-user spending limit in USD
DEFAULT_BUDGET=0.05
